{
  "name": "reading-canon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "husky",
    "create-curator": "tsx --env-file=.env.local scripts/create-curator.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.2",
    "@tanstack/react-query": "^5.64.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.4.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.1.5",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.81.0",
    "tsc-files": "^1.1.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint",
      "tsc-files --noEmit"
    ],
    "*.{ts,tsx,test.ts,test.tsx}": [
      "vitest related --run"
    ]
  }
}
