# Reading Canon - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# .env.local is git-ignored and will not be committed

# Supabase Configuration (Client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Admin Configuration (Scripts Only)
# WARNING: Keep this secret! Never commit or expose to client code.
# Find in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Curator Account Setup (for create-curator script)
# CURATOR_EMAIL=curator@example.com
# CURATOR_PASSWORD=your-secure-password

# Note: Variables prefixed with VITE_ are accessible in the client.
# Variables without VITE_ prefix are only available in Node.js scripts.
# See: https://vitejs.dev/guide/env-and-mode.html
